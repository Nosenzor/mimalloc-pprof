/build/
ide/vs20??/*.db
ide/vs20??/*.opendb
ide/vs20??/*.user
ide/vs20??/.vs
ide/vs20??/VTune*
/out/
rust/target/
# setup-soldr's cook cache restores its archives beside the target dir (#444).
rust/target.soldr-*
rust/benchmark-report.html
docs/
*.zip
*.tar
*.gz
# ...except checked-in test fixtures, which are stored compressed on purpose:
# ci/tests/fixtures/benchmark/legacy/latest.json.gz is 2.4 MB of synthetic
# samples that would otherwise dominate the repository's fixture bytes.
!ci/tests/fixtures/**/*.gz
.vscode
.DS_STore
# Local Python environments and caches (repository-relative paths).
/.venv/
/.pytest_cache/
/.ruff_cache/
/ci/__pycache__/
/ci/tests/__pycache__/
/ci/spike/__pycache__/
/examples/heap-snapshot/__pycache__/

# Agent runtime state; keep agent configuration files visible.
/.claude/scheduled_tasks.lock
/.claude/worktrees/

# uv run writes an (empty) lock file here; pyproject.toml has no [project] table, so it carries nothing
/uv.lock

# clud /grind run records: local only, never committed
/.clud/grind/
/.clud/logs/

# Issue 585 retains original measurements before temporary evidence is cleaned.
!/.github/assets/perf-585/measurements.zip
!/.github/assets/perf-585/arena-reclaim-wait.zip

# Issue 610 retains original measurements, including rejected candidates.
!/.github/assets/perf-610/measurements.zip

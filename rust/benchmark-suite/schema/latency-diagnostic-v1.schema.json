{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackees/mimalloc-pprof/schema/latency-diagnostic-v1.schema.json",
  "title": "mimalloc-pprof opt-in matched perf-ab old-fork latency diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric_schema_version", "status", "run_seed", "measurement_scope", "host", "old_fork", "candidate", "cells", "samples"],
  "properties": {
    "metric_schema_version": { "const": "transaction-latency-v1" },
    "status": { "const": "diagnostic" },
    "run_seed": { "type": "integer", "minimum": 1 },
    "measurement_scope": { "const": "paired per-operation latency replay of the exact perf-ab seeded transaction stream; Rust child monotonic timing with sampled operations and a no-allocation control; not perf-ab aggregate CPU timing" },
    "host": { "$ref": "#/$defs/host" },
    "old_fork": { "$ref": "#/$defs/source" },
    "candidate": { "$ref": "#/$defs/source" },
    "cells": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "$ref": "#/$defs/cell" }
    },
    "samples": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["arm", "execution_order", "sample"],
        "properties": {
          "arm": { "enum": ["old-fork", "candidate"] },
          "execution_order": { "enum": [0, 1] },
          "sample": { "$ref": "latency-v1.schema.json#/$defs/sample" }
        }
      }
    }
  },
  "$defs": {
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["stable_host_id", "stable_host_identity_status", "stable_host_identity_source", "runner_fingerprint_sha256", "cpu_model", "physical_cores", "logical_cores", "target", "transparent_hugepage", "affinity_policy", "affinity_logical_cpu_ids", "isolation_claim"],
      "properties": {
        "stable_host_id": { "type": "string" },
        "stable_host_identity_status": { "enum": ["reported", "not-provided"] },
        "stable_host_identity_source": { "enum": ["operator-override", "runner-reported", "not-provided"] },
        "runner_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "cpu_model": { "type": "string", "minLength": 1 },
        "physical_cores": { "type": "integer", "minimum": 1 },
        "logical_cores": { "type": "integer", "minimum": 8 },
        "target": { "type": "string", "minLength": 1 },
        "transparent_hugepage": { "type": "string", "minLength": 1 },
        "affinity_policy": { "type": "string", "minLength": 1 },
        "affinity_logical_cpu_ids": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
        "isolation_claim": { "const": "old-fork and candidate arms alternate on one host; exclusive-host isolation is not claimed" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha", "library_sha256", "child_binary_sha256"],
      "properties": {
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "library_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "child_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "allocatorSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["measured", "control", "overhead_valid"],
      "properties": {
        "measured": { "$ref": "latency-v1.schema.json#/$defs/distribution" },
        "control": { "$ref": "latency-v1.schema.json#/$defs/distribution" },
        "overhead_valid": { "type": "boolean" }
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "workload_id", "trace_checksum", "thread_point", "thread_count", "transactions_per_worker", "sample_denominator", "transaction_definition", "old_fork", "candidate", "paired_summaries"],
      "properties": {
        "scenario_id": { "enum": ["large-object-128k-diagnostic", "random-large-bursty-diagnostic", "large-class-diagnostic"] },
        "workload_id": { "enum": ["size 128 KiB/1 (#422)", "size 128 KiB/8 (diagnostic)", "random-large-bursty/8", "large-class/8"] },
        "trace_checksum": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "thread_point": { "enum": ["1", "8"] },
        "thread_count": { "enum": [1, 8] },
        "transactions_per_worker": { "type": "integer", "minimum": 1 },
        "sample_denominator": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "transaction_definition": { "enum": [
          "perf-ab seeded 8-slot replacement/free stream; 128 KiB allocations touch each 4 KiB page and free the replaced slot",
          "perf-ab random-large-bursty seeded 8-slot stream; each 8-burst phase touches every 4 KiB page, drains slots, then idles 300 ms",
          "perf-ab large-class seeded 8-slot replacement/free stream with uniform 96-512 KiB requests and per-page touches"
        ] },
        "old_fork": { "$ref": "#/$defs/allocatorSummary" },
        "candidate": { "$ref": "#/$defs/allocatorSummary" },
        "paired_summaries": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["quantile", "summary"],
            "properties": {
              "quantile": { "enum": ["p50", "p95", "p99"] },
              "summary": { "$ref": "#/$defs/diagnosticPairedEffect" }
            }
          }
        }
      }
    },
    "diagnosticPairedEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "reference_id", "direction", "block_count", "effect", "confidence_interval", "bootstrap", "informational"],
      "properties": {
        "candidate_id": { "const": "mimalloc-pprof-candidate" },
        "reference_id": { "const": "mimalloc-pprof-old-fork" },
        "direction": { "const": "lower-is-better" },
        "block_count": { "type": "integer", "minimum": 1 },
        "effect": { "type": "number", "exclusiveMinimum": 0 },
        "confidence_interval": {
          "type": "object", "additionalProperties": false,
          "required": ["lower", "upper", "confidence_level"],
          "properties": {
            "lower": { "type": "number", "exclusiveMinimum": 0 },
            "upper": { "type": "number", "exclusiveMinimum": 0 },
            "confidence_level": { "const": 0.95 }
          }
        },
        "bootstrap": {
          "type": "object", "additionalProperties": false,
          "required": ["seed", "resample_count", "method", "prng"],
          "properties": {
            "seed": { "type": "integer", "minimum": 0 },
            "resample_count": { "const": 10000 },
            "method": { "const": "percentile-whole-block-bootstrap-of-per-block-type7-quantiles-v1" },
            "prng": { "const": "splitmix64-rejection-v1" }
          }
        },
        "informational": { "const": true }
      }
    }
  }
}
